{
  "apiVersion": "patchrover.dev/agent/v1alpha1",
  "mode": "propose",
  "interval": "15m",
  "statePath": "../.patchrover/agent-state.json",
  "allowedHosts": [
    "www.cisa.gov",
    "api.github.com",
    "control.patchrover.example"
  ],
  "sources": [
    {
      "id": "cisa-kev",
      "kind": "cisa-kev",
      "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
    },
    {
      "id": "github-advisories",
      "kind": "github-advisories",
      "url": "https://api.github.com/advisories?per_page=100"
    }
  ],
  "targets": [
    {
      "id": "example-service",
      "pack": "../packs/litellm-1.107.0-compromise",
      "evidence": {
        "repositoryPath": "../packs/litellm-1.107.0-compromise/fixtures/affected",
        "kubeSnapshot": "../packs/litellm-1.107.0-compromise/fixtures/affected/pods.json"
      },
      "githubRepository": "YOUR_ACCOUNT/YOUR_REPOSITORY",
      "baseBranch": "main",
      "vaultDatabaseRotations": [
        "example-service-production"
      ]
    }
  ],
  "policy": {
    "maxActionsPerRun": 2
  },
  "integrations": {
    "controlPlane": {
      "url": "https://control.patchrover.example",
      "tokenEnv": "PATCHROVER_CONTROL_PLANE_TOKEN"
    }
  }
}
