---
import RoverMark from '../components/RoverMark.astro';
import '../styles/landing.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const docs = `${base}getting-started/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found — PatchRover</title>
  </head>
  <body>
    <main class="not-found">
      <RoverMark size={64} />
      <p class="eyebrow"><span></span> 404 · Trail ended</p>
      <h1>Evidence path<br /><em>not found.</em></h1>
      <p>The requested page is not part of this PatchRover trail.</p>
      <div class="hero-actions">
        <a class="button primary" href={base}>Return home</a>
        <a class="button secondary" href={docs}>Open documentation</a>
      </div>
    </main>
  </body>
</html>

<style>
  .not-found { min-height: 100vh; max-width: 900px; margin: 0 auto; padding: 12vh 30px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .not-found .eyebrow { margin: 28px 0 16px; }
  .not-found h1 { font-size: clamp(58px, 10vw, 110px); }
  .not-found > p:not(.eyebrow) { max-width: 520px; color: var(--muted); font-size: 18px; }
</style>
