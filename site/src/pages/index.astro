---
import RoverMark from '../components/RoverMark.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path.replace(/^\//, '')}`;
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const title = 'PatchRover — Track. Fix. Prove.';
const description = 'Follow a critical vulnerability from advisory to repository, container, and the workload actually running.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07120f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={link('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="PatchRover home">
        <RoverMark size={38} />
        <span>PatchRover</span>
        <small>alpha</small>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#workflow">Workflow</a>
        <a href="#packs">Packs</a>
        <a href="#security">Security</a>
        <a href={link('getting-started/')}>Docs</a>
      </nav>
      <a class="header-cta" href="#demo">Run demo <span aria-hidden="true">↘</span></a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Local-first incident response</div>
          <h1 id="hero-title">Track. Fix.<br /><em>Prove.</em></h1>
          <p class="lede">PatchRover follows a critical vulnerability from advisory to repository, container, and the workload actually running in production.</p>
          <div class="hero-actions">
            <a class="button primary" href="#demo">Run the five-minute demo <span aria-hidden="true">→</span></a>
            {
              githubUrl ? (
                <a class="button secondary" href={githubUrl}>View on GitHub</a>
              ) : (
                <a class="button secondary" href="#source-status">GitHub launch status</a>
              )
            }
          </div>
          <ul class="trust-list" aria-label="Product principles">
            <li>Read-only by default</li>
            <li>No model required</li>
            <li>No silent data upload</li>
          </ul>
        </div>

        <div class="hero-visual" aria-label="An incident trail from advisory to verified runtime">
          <div class="signal-grid" aria-hidden="true"></div>
          <div class="incident-card">
            <div class="card-topline"><span class="status-dot"></span> CRITICAL ADVISORY <span>09:41 UTC</span></div>
            <strong>CVE-2026-109618</strong>
            <p>Unauthenticated remote code execution</p>
          </div>
          <div class="trail-line trail-one" aria-hidden="true"></div>
          <div class="asset-node node-repo">
            <span class="node-icon" aria-hidden="true">&lt;/&gt;</span>
            <div><small>REPOSITORY</small><strong>php:8.4.26</strong></div>
            <span class="pill affected">Affected</span>
          </div>
          <div class="trail-line trail-two" aria-hidden="true"></div>
          <div class="asset-node node-image">
            <span class="node-icon cube" aria-hidden="true">◇</span>
            <div><small>BUILT IMAGE</small><strong>sha256:7fd…a92</strong></div>
            <span class="pill observed">Observed</span>
          </div>
          <div class="trail-line trail-three" aria-hidden="true"></div>
          <div class="asset-node node-runtime">
            <span class="node-icon" aria-hidden="true">◎</span>
            <div><small>RUNNING WORKLOAD</small><strong>api-prod / 12 pods</strong></div>
            <span class="pill fixed">Verified</span>
          </div>
          <div class="rover-badge" aria-hidden="true"><RoverMark size={64} label="" /><span>Evidence<br />retrieved</span></div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Project facts">
        <div><strong>4</strong><span>deterministic verdicts</span></div>
        <div><strong>0</strong><span>production writes in v1</span></div>
        <div><strong>2</strong><span>signed launch packs</span></div>
        <div><strong>100%</strong><span>synthetic demo fixtures</span></div>
      </section>

      <section class="workflow section" id="workflow" aria-labelledby="workflow-title">
        <div class="section-intro">
          <div class="eyebrow"><span></span> One evidence trail</div>
          <h2 id="workflow-title">A fix is not finished<br />until production agrees.</h2>
          <p>Scanners find risk. PatchRover’s wedge is proving whether the reviewed fix reached the artifact and workload that matter.</p>
        </div>
        <ol class="steps">
          <li>
            <span class="step-number">01</span>
            <div class="step-icon" aria-hidden="true">⌁</div>
            <h3>Track</h3>
            <p>A signed response pack maps authoritative incident data to source, SBOM, image, and explicit Kubernetes evidence.</p>
            <code>verdict: affected</code>
          </li>
          <li>
            <span class="step-number">02</span>
            <div class="step-icon" aria-hidden="true">△</div>
            <h3>Fix</h3>
            <p>PatchRover prepares a local diff, test plan, operational checklist, and human approvals. It never pushes or deploys.</p>
            <code>proposal: review_required</code>
          </li>
          <li>
            <span class="step-number">03</span>
            <div class="step-icon" aria-hidden="true">✓</div>
            <h3>Prove</h3>
            <p>Fresh evidence confirms the fixed source and immutable running digest, then creates a redacted, signed receipt.</p>
            <code>receipt: integrity_valid</code>
          </li>
        </ol>
      </section>

      <section class="demo section" id="demo" aria-labelledby="demo-title">
        <div class="demo-copy">
          <div class="eyebrow light"><span></span> Deterministic and account-free</div>
          <h2 id="demo-title">See the full incident loop in under five minutes.</h2>
          <p>The demo creates only temporary synthetic files. It makes no network request, downloads no compromised artifact, calls no model, and touches no production system.</p>
          <div class="command-box">
            <code id="demo-command">go run ./cmd/patchrover demo</code>
            <button type="button" data-copy="#demo-command" aria-label="Copy demo command">Copy</button>
          </div>
          <p class="command-note">Run from a local PatchRover checkout. Binary releases begin after public launch.</p>
          <a class="text-link" href={link('getting-started/')}>Read the quickstart <span aria-hidden="true">→</span></a>
        </div>
        <div class="terminal" aria-label="Example PatchRover demo output">
          <div class="terminal-bar"><span></span><span></span><span></span><small>patchrover demo</small></div>
          <div class="terminal-body">
            <p><b>PatchRover demo</b> — Track. Fix. Prove.</p>
            <p class="dim">Synthetic fixtures only. No network or model.</p>
            <p><i>1/5</i> Verified signed response pack</p>
            <p><i>2/5</i> ASSESS&nbsp;&nbsp;<mark class="red">affected</mark></p>
            <p><i>3/5</i> PROPOSE local diff only</p>
            <p class="diff"><del>- litellm==1.107.0</del><br /><ins>+ litellm==1.106.2</ins></p>
            <p><i>4/5</i> VERIFY&nbsp;&nbsp;<mark>fixed</mark></p>
            <p><i>5/5</i> RECEIPT integrity=true</p>
            <p class="complete">● Demo complete</p>
          </div>
        </div>
      </section>

      <section class="verdicts section" aria-labelledby="verdict-title">
        <div class="section-intro compact">
          <div class="eyebrow"><span></span> Honest verdicts</div>
          <h2 id="verdict-title">Missing evidence never becomes a green badge.</h2>
        </div>
        <div class="verdict-grid">
          <article class="verdict-card danger">
            <div><span></span>AFFECTED</div>
            <h3>An exact rule matched.</h3>
            <p>Source version <code>8.4.26</code> and the running workload are below the signed pack’s fixed threshold.</p>
            <small>Evidence confidence: high</small>
          </article>
          <article class="verdict-card unknown">
            <div><span></span>UNKNOWN</div>
            <h3>The facts are incomplete.</h3>
            <p>A mutable tag is present, but no immutable runtime digest was observed. PatchRover refuses to infer safety.</p>
            <small>Action: collect runtime digest</small>
          </article>
          <article class="verdict-card safe">
            <div><span></span>FIXED + RECEIPT</div>
            <h3>Production matches the fix.</h3>
            <p>Fixed source and a new running image digest were observed. The redacted receipt passes integrity verification.</p>
            <small>Identity trust: policy-dependent</small>
          </article>
        </div>
      </section>

      <section class="packs section" id="packs" aria-labelledby="packs-title">
        <div class="section-intro split">
          <div>
            <div class="eyebrow"><span></span> Response Pack registry</div>
            <h2 id="packs-title">Incident knowledge that can be reviewed, signed, and improved.</h2>
          </div>
          <p>Packs are declarative JSON. They reference official sources and invoke only built-in collectors—never arbitrary shell code.</p>
        </div>
        <div class="pack-table" role="table" aria-label="Initial PatchRover response packs">
          <div class="pack-row table-head" role="row">
            <span role="columnheader">Pack</span><span role="columnheader">Coverage</span><span role="columnheader">Review</span><span role="columnheader">Author</span>
          </div>
          <article class="pack-row" role="row">
            <span role="cell"><b>php-2026-rce</b><small>v1.0.0</small></span>
            <span role="cell">CVE-2026-109618<br />CVE-2026-109619</span>
            <span role="cell"><em class="verified">Verified</em></span>
            <span role="cell">PatchRover maintainers</span>
          </article>
          <article class="pack-row" role="row">
            <span role="cell"><b>litellm-1.107.0-compromise</b><small>v0.1.0</small></span>
            <span role="cell">Package version<br />Exact published digest</span>
            <span role="cell"><em class="provisional">Provisional</em></span>
            <span role="cell">PatchRover maintainers</span>
          </article>
        </div>
        <div class="pack-walkthroughs" aria-label="Response pack walkthroughs">
          <article>
            <span>01 · PHP RCE</span>
            <h3>Version line → rebuilt image → running digest</h3>
            <ol>
              <li>Match PHP 8.2–8.5 evidence against the signed minimum fixed version for its release line.</li>
              <li>Propose the exact supported upgrade while preserving image-tag suffixes such as <code>-apache</code>.</li>
              <li>Issue a receipt only after a fixed runtime and immutable SHA-256 digest are observed.</li>
            </ol>
          </article>
          <article>
            <span>02 · LiteLLM compromise</span>
            <h3>Package indicator → clean rebuild → credential response</h3>
            <ol>
              <li>Match only the compromised version, incident-time tags, or a fully published affected digest.</li>
              <li>Keep partial digests and missing runtime identity unknown; never download the compromised artifact.</li>
              <li>Require a clean rebuild, fresh running digest, incident review, and the pack’s credential-rotation checklist.</li>
            </ol>
          </article>
        </div>
        <p class="pack-note">The LiteLLM investigation is evolving. Its pack expires quickly and supports signed replacement or revocation. Prefix-only digests are not treated as exact indicators.</p>
      </section>

      <section class="security section" id="security" aria-labelledby="security-title">
        <div class="security-panel">
          <div class="section-intro compact">
            <div class="eyebrow light"><span></span> Security model</div>
            <h2 id="security-title">Useful under pressure.<br />Conservative by design.</h2>
          </div>
          <div class="security-grid">
            <div><strong>01</strong><h3>Deterministic verdicts</h3><p>AI may explain evidence or draft a proposal. It cannot turn <code>unknown</code> into <code>not_affected</code>.</p></div>
            <div><strong>02</strong><h3>Read-only collection</h3><p>Kubernetes requires an explicit context and calls only fixed metadata reads. v1 never changes production.</p></div>
            <div><strong>03</strong><h3>Signed content</h3><p>Pack bytes, trails, and DSSE-wrapped in-toto receipts fail closed when modified.</p></div>
            <div><strong>04</strong><h3>Private by default</h3><p>Receipts tokenize internal asset identities. Public sharing is a separate, explicit decision.</p></div>
          </div>
          <a class="text-link light-link" href={link('security-model/')}>Read the threat model and limitations <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="comparison section" aria-labelledby="comparison-title">
        <div class="section-intro compact">
          <div class="eyebrow"><span></span> Open-core, clearly divided</div>
          <h2 id="comparison-title">Safety knowledge stays public. Operations become the business.</h2>
        </div>
        <div class="comparison-grid">
          <article>
            <header><span>APACHE-2.0</span><h3>Open source</h3><p>Everything required to assess and prove one authorized environment locally.</p></header>
            <ul><li>CLI and deterministic engine</li><li>Response-pack format and registry</li><li>Evidence collectors and GitHub Action</li><li>Receipt creation and verification</li><li>Local-model and BYOK interfaces</li></ul>
            <a href={link('getting-started/')}>Explore the docs →</a>
          </article>
          <article class="commercial">
            <header><span>DESIGN PARTNERS</span><h3>Commercial</h3><p>Continuous evidence and governance across an organization’s software fleet.</p></header>
            <ul><li>Continuous fleet monitoring</li><li>Private packs and blast-radius maps</li><li>SSO, RBAC, history, and drift alerts</li><li>Enterprise integrations and SLAs</li><li>Implementation and incident support</li></ul>
            {contactEmail ? <a href={`mailto:${contactEmail}`}>Discuss a design partnership →</a> : <a href="#source-status">Contact status →</a>}
          </article>
        </div>
      </section>

      <section class="launch-status section" id="source-status" aria-labelledby="status-title">
        <div>
          <div class="eyebrow"><span></span> Credible launch, not an empty repository</div>
          <h2 id="status-title">Private prelaunch build.</h2>
        </div>
        <div>
          <p>The source, two signed packs, threat model, contribution process, tests, and GitHub Pages site are being prepared together. The alpha repository will publish from founder Shubham Jain’s GitHub account after private CI, repository protections, release provenance, and live Pages checks pass.</p>
          <ul>
            <li><span class="done">✓</span> Local deterministic demo and golden corpus</li>
            <li><span class="done">✓</span> Signed alpha packs and tamper checks</li>
            <li><span class="pending">→</span> Trademark, domain, and account clearance</li>
            <li><span class="pending">→</span> Organization controls and first public release</li>
          </ul>
          <p class="contact-status">{contactEmail ? <>Design-partner contact: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></> : <>The company contact address will appear here after domain clearance. No lead-capture backend is used.</>}</p>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href={base}><RoverMark size={36} /><span>PatchRover</span></a>
      <p>Track. Fix. Prove.<br /><small>Open-source incident response evidence.</small></p>
      <nav aria-label="Footer navigation"><a href={link('getting-started/')}>Documentation</a><a href={link('roadmap/')}>Roadmap</a><a href={link('contributing/')}>Contribute</a><a href={link('governance/')}>Governance</a></nav>
      <p class="legal">Apache-2.0 · Working alpha · Not a guarantee of security</p>
    </footer>

    <script>
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
		  const selector = button.getAttribute('data-copy');
		  if (!selector) return;
          const target = document.querySelector(selector);
          if (!(target instanceof HTMLElement)) return;
          try {
            await navigator.clipboard.writeText(target.textContent || '');
            const original = button.textContent;
            button.textContent = 'Copied';
            window.setTimeout(() => { button.textContent = original; }, 1600);
          } catch {
            target.focus();
          }
        });
      });
    </script>
  </body>
</html>
