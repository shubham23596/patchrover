---
import RoverMark from '../components/RoverMark.astro';
import '../styles/landing.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const link = (path: string) => `${base}${path.replace(/^\//, '')}`;
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
const discussionsUrl = githubUrl ? `${githubUrl}/discussions` : link('getting-started/');
const title = 'PatchRover — Track. Fix. Prove.';
const description = 'Find where critical vulnerabilities affect your code and running systems, prepare safe fixes, and confirm the fixed version is live.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07120f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={link('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="PatchRover home">
        <RoverMark size={38} />
        <span>PatchRover</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#workflow">Workflow</a>
        <a href="#packs">Packs</a>
        <a href="#security">Security</a>
        <a href={link('getting-started/')}>Docs</a>
      </nav>
      <a class="header-cta" href="#approval">Approval flow <span aria-hidden="true">↘</span></a>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> Open-source security agent</div>
          <h1 id="hero-title">Track. Fix.<br /><em>Prove.</em></h1>
          <p class="lede">PatchRover finds where a serious security issue affects your systems, shows the exact fix, asks for approval, and checks that the fixed version is live.</p>
          <div class="hero-actions">
            <a class="button primary" href="#approval">See the approval flow <span aria-hidden="true">→</span></a>
            {
              githubUrl ? (
                <a class="button secondary" href={githubUrl}>View on GitHub</a>
              ) : (
                <a class="button secondary" href={link('getting-started/')}>Read the docs</a>
              )
            }
          </div>
          <ul class="trust-list" aria-label="Product principles">
            <li>Approval before every fix</li>
            <li>No automatic deployment</li>
            <li>No data upload by default</li>
          </ul>
        </div>

        <div class="hero-visual" aria-label="An incident trail from advisory to verified runtime">
          <div class="signal-grid" aria-hidden="true"></div>
          <div class="incident-card">
            <div class="card-topline"><span class="status-dot"></span> CRITICAL ADVISORY <span>09:41 UTC</span></div>
            <strong>CVE-2026-109618</strong>
            <p>Unauthenticated remote code execution</p>
          </div>
          <div class="trail-line trail-one" aria-hidden="true"></div>
          <div class="asset-node node-repo">
            <span class="node-icon" aria-hidden="true">&lt;/&gt;</span>
            <div><small>REPOSITORY</small><strong>php:8.4.26</strong></div>
            <span class="pill affected">Affected</span>
          </div>
          <div class="trail-line trail-two" aria-hidden="true"></div>
          <div class="asset-node node-image">
            <span class="node-icon cube" aria-hidden="true">◇</span>
            <div><small>BUILT IMAGE</small><strong>sha256:7fd…a92</strong></div>
            <span class="pill observed">Observed</span>
          </div>
          <div class="trail-line trail-three" aria-hidden="true"></div>
          <div class="asset-node node-runtime">
            <span class="node-icon" aria-hidden="true">◎</span>
            <div><small>RUNNING WORKLOAD</small><strong>api-prod / 12 pods</strong></div>
            <span class="pill fixed">Verified</span>
          </div>
          <div class="rover-badge" aria-hidden="true"><RoverMark size={64} label="" /><span>Fix<br />verified</span></div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Project facts">
        <div><strong>4</strong><span>clear result states</span></div>
        <div><strong>2</strong><span>approved fix types</span></div>
        <div><strong>2</strong><span>included incident packs</span></div>
        <div><strong>0</strong><span>unapproved changes</span></div>
      </section>

      <section class="workflow section" id="workflow" aria-labelledby="workflow-title">
        <div class="section-intro">
          <div class="eyebrow"><span></span> How it works</div>
          <h2 id="workflow-title">Find the risk. Prepare the fix.<br />Check what is live.</h2>
          <p>Most tools stop after changing code. PatchRover also checks the container and running workload so your team knows whether the fix reached production.</p>
        </div>
        <ol class="steps">
          <li>
            <span class="step-number">01</span>
            <div class="step-icon" aria-hidden="true">⌁</div>
            <h3>Track</h3>
            <p>Checks approved code, container images, and Kubernetes workloads against a trusted incident Pack.</p>
            <code>result: affected</code>
          </li>
          <li>
            <span class="step-number">02</span>
            <div class="step-icon" aria-hidden="true">△</div>
            <h3>Fix</h3>
            <p>Shows the exact change and asks a responsible person to approve it before anything is applied.</p>
            <code>action: review required</code>
          </li>
          <li>
            <span class="step-number">03</span>
            <div class="step-icon" aria-hidden="true">✓</div>
            <h3>Prove</h3>
            <p>Checks the live workload and creates a signed Receipt when the fixed version is running.</p>
            <code>result: verified</code>
          </li>
        </ol>
      </section>

      <section class="workflow section" aria-labelledby="agent-title">
        <div class="section-intro">
          <div class="eyebrow"><span></span> Automation you control</div>
          <h2 id="agent-title">Watch for new incidents.<br />Respond within clear limits.</h2>
          <p>PatchRover watches trusted security feeds. When it finds a supported issue, it prepares the fix and asks your team for approval.</p>
        </div>
        <ol class="steps">
          <li><span class="step-number">01</span><div class="step-icon" aria-hidden="true">◉</div><h3>Watch</h3><p>Checks trusted feeds and re-runs approved scans when a relevant incident appears.</p><code>always watching</code></li>
          <li><span class="step-number">02</span><div class="step-icon" aria-hidden="true">◇</div><h3>Ask</h3><p>Shows the affected system, proposed change, and why the fix is needed.</p><code>approval required</code></li>
          <li><span class="step-number">03</span><div class="step-icon" aria-hidden="true">✓</div><h3>Fix</h3><p>After approval, opens the exact pull request or rotates an allowlisted machine credential. It never changes human passwords or deploys to production.</p><code>approved action only</code></li>
        </ol>
      </section>

      <section class="approval section" id="approval" aria-labelledby="approval-title">
        <div class="approval-copy">
          <div class="eyebrow light"><span></span> Human approval built in</div>
          <h2 id="approval-title">Nothing changes until a person says yes.</h2>
          <p>PatchRover shows the exact file, version, or machine credential it wants to change. The approved action is recorded in a tamper-evident history before the fix runs.</p>
          <a class="text-link light-link" href={link('autonomous-agent/')}>Read the approval workflow <span aria-hidden="true">→</span></a>
        </div>
        <div class="terminal" aria-label="Example PatchRover approval request">
          <div class="terminal-bar"><span></span><span></span><span></span><small>PatchRover approval</small></div>
          <div class="terminal-body">
            <p><b>FIX REQUIRES APPROVAL</b></p>
            <p><i>ISSUE</i>&nbsp;&nbsp;<mark class="red">affected</mark> LiteLLM package</p>
            <p><i>CHANGE</i>&nbsp; requirements.txt</p>
            <p class="diff"><del>- litellm==1.107.0</del><br /><ins>+ litellm==1.106.2</ins></p>
            <p><i>ASK</i>&nbsp;&nbsp;&nbsp; Apply this exact fix? <b>yes</b></p>
            <p><i>ACTION</i>&nbsp; Pull request opened for review</p>
            <p class="complete">● Approved action completed</p>
          </div>
        </div>
      </section>

      <section class="verdicts section" aria-labelledby="verdict-title">
        <div class="section-intro compact">
          <div class="eyebrow"><span></span> Clear answers</div>
          <h2 id="verdict-title">No proof means no green check.</h2>
        </div>
        <div class="verdict-grid">
          <article class="verdict-card danger">
            <div><span></span>AFFECTED</div>
            <h3>A vulnerable version was found.</h3>
            <p>PatchRover found the affected version in the code and in the running workload.</p>
            <small>Next: prepare the fix</small>
          </article>
          <article class="verdict-card unknown">
            <div><span></span>UNKNOWN</div>
            <h3>More evidence is needed.</h3>
            <p>PatchRover cannot confirm which image is running, so it does not call the system safe.</p>
            <small>Next: collect the running image ID</small>
          </article>
          <article class="verdict-card safe">
            <div><span></span>FIXED + RECEIPT</div>
            <h3>The fix is live.</h3>
            <p>The fixed code and running image were both confirmed. PatchRover creates a signed Receipt.</p>
            <small>Receipt ready to verify</small>
          </article>
        </div>
      </section>

      <section class="packs section" id="packs" aria-labelledby="packs-title">
        <div class="section-intro split">
          <div>
            <div class="eyebrow"><span></span> Incident Packs</div>
            <h2 id="packs-title">One trusted playbook for each security incident.</h2>
          </div>
          <p>A Pack tells PatchRover what to look for, how to fix it, and how to confirm the fix. Packs cannot run arbitrary commands.</p>
        </div>
        <div class="pack-table" role="table" aria-label="Initial PatchRover response packs">
          <div class="pack-row table-head" role="row">
            <span role="columnheader">Pack</span><span role="columnheader">Coverage</span><span role="columnheader">Review</span><span role="columnheader">Author</span>
          </div>
          <article class="pack-row" role="row">
            <span role="cell"><b>php-2026-rce</b><small>v1.0.0</small></span>
            <span role="cell">CVE-2026-109618<br />CVE-2026-109619</span>
            <span role="cell"><em class="verified">Verified</em></span>
            <span role="cell">PatchRover maintainers</span>
          </article>
          <article class="pack-row" role="row">
            <span role="cell"><b>litellm-1.107.0-compromise</b><small>v0.1.0</small></span>
            <span role="cell">Package version<br />Exact published digest</span>
            <span role="cell"><em class="provisional">Provisional</em></span>
            <span role="cell">PatchRover maintainers</span>
          </article>
        </div>
        <div class="pack-walkthroughs" aria-label="Response pack walkthroughs">
          <article>
            <span>01 · PHP RCE</span>
            <h3>Find old PHP → update it → confirm the new version is live</h3>
            <ol>
              <li>Find affected PHP versions in approved code and workloads.</li>
              <li>Prepare the correct supported upgrade for each version line.</li>
              <li>Create a Receipt only after the fixed image is running.</li>
            </ol>
          </article>
          <article>
            <span>02 · LiteLLM compromise</span>
            <h3>Find the compromised package → rebuild safely → rotate exposed keys</h3>
            <ol>
              <li>Find the known compromised version without downloading it.</li>
              <li>Require a clean rebuild and confirm the new image is running.</li>
              <li>Guide the team through the required machine-key rotations.</li>
            </ol>
          </article>
        </div>
        <p class="pack-note">The LiteLLM incident is still changing. Its Pack expires quickly and can be replaced or revoked when new facts appear.</p>
      </section>

      <section class="security section" id="security" aria-labelledby="security-title">
        <div class="security-panel">
          <div class="section-intro compact">
            <div class="eyebrow light"><span></span> Built-in safety</div>
            <h2 id="security-title">Automation with hard limits.</h2>
          </div>
          <div class="security-grid">
            <div><strong>01</strong><h3>Rules decide the result</h3><p>AI can explain a result, but it cannot label missing evidence as safe.</p></div>
            <div><strong>02</strong><h3>No surprise changes</h3><p>PatchRover never runs shell commands, merges pull requests, deploys code, or changes human passwords.</p></div>
            <div><strong>03</strong><h3>Tampering is detected</h3><p>Changes to a Pack, Trail, or Receipt make verification fail.</p></div>
            <div><strong>04</strong><h3>Private by default</h3><p>Receipts hide internal names. Sharing them is always optional.</p></div>
          </div>
          <a class="text-link light-link" href={link('security-model/')}>See all safety rules <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="comparison section" aria-labelledby="comparison-title">
        <div class="section-intro compact">
          <div class="eyebrow"><span></span> Open source + team edition</div>
          <h2 id="comparison-title">Start free. Add team controls when you need them.</h2>
        </div>
        <div class="comparison-grid">
          <article>
            <header><span>APACHE-2.0</span><h3>Open source</h3><p>Find affected systems and independently verify the result.</p></header>
            <ul><li>CLI and core security checks</li><li>Public incident Packs</li><li>GitHub Action and evidence collection</li><li>Signed Receipt verification</li><li>Local AI or your own model key</li></ul>
            <a href={link('getting-started/')}>Explore the docs →</a>
          </article>
          <article class="commercial">
            <header><span>COMMERCIAL</span><h3>For teams</h3><p>Monitor, approve, and fix issues across your organization.</p></header>
            <ul><li>Continuous monitoring</li><li>Approval inbox and approved fix application</li><li>Private Packs and company-wide impact view</li><li>Team access controls and audit history</li><li>Integrations, support, and SLA</li></ul>
            {contactEmail ? <a href={`mailto:${contactEmail}`}>Discuss a design partnership →</a> : <a href={discussionsUrl}>Talk to us on GitHub →</a>}
          </article>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href={base}><RoverMark size={36} /><span>PatchRover</span></a>
      <p>Track. Fix. Prove.<br /><small>Know what is affected and whether the fix is live.</small></p>
      <nav aria-label="Footer navigation"><a href={link('getting-started/')}>Documentation</a><a href={link('roadmap/')}>Roadmap</a><a href={link('contributing/')}>Contribute</a><a href={link('governance/')}>Governance</a></nav>
      <p class="legal">Apache-2.0 · Human approval required</p>
    </footer>

  </body>
</html>
